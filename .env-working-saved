# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=edapt
POSTGRES_PASSWORD=edapt_dev_password
POSTGRES_DB=edaptdb

# ─── Backend ──────────────────────────────────────────────────────────────────
# Uses the Docker service name "db" as the host (internal network)
DATABASE_URL=postgresql+asyncpg://edapt:edapt_dev_password@db:5432/edaptdb
LOG_LEVEL=info

# ─── Frontend ─────────────────────────────────────────────────────────────────
REACT_APP_API_BASE_URL=http://localhost:8000

# ─── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@edapt.local
PGADMIN_DEFAULT_PASSWORD=admin
