# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=edapt_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=edapt_v2
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN consumed by SQLAlchemy (backend)
DATABASE_URL=postgresql+asyncpg://edapt_user:changeme@db:5432/edapt_v2

# ── FastAPI ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret
ENVIRONMENT=development          # development | production
LOG_LEVEL=info

# ── pgAdmin ──────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@edapt.local
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── OAuth sign-in (Google / Microsoft) ───────────────────
# Leave a client ID blank to hide that provider's button on the login page —
# nothing else breaks. Google: console.cloud.google.com -> APIs & Services ->
# Credentials -> OAuth client ID (type: Web application, no secret needed —
# only the ID token is verified, never exchanged). Microsoft: Azure Portal ->
# App registrations -> New registration -> Application (client) ID; add
# "Single-page application" platform with redirect URI matching your
# frontend origin (e.g. http://localhost:3000).
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Same values, exposed to the React app (CRA only serves REACT_APP_* vars)
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=
REACT_APP_MICROSOFT_TENANT_ID=common

# ── React (prefix REACT_APP_ so CRA exposes them) ────────
REACT_APP_API_BASE_URL=http://localhost:8000

# ── Default login credentials ────────────────────────────
# Super-admin:  email=admin      password=Admin@2025!
# Demo lecturer: email=user      password=Lect@2025!
