# ── EDAPT v2 Backend — Production Image ───────────────────────────────────
# Multi-stage build: builder installs deps, runner is a lean final image.

# ── Stage 1: builder ───────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: runner ────────────────────────────────────────────────────────
FROM python:3.12-slim AS runner

WORKDIR /app

# Runtime lib only (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY app/ ./app/
# scripts/retrain_loop.sh — the scheduled-retrain sidecar service (see
# docker-compose.prod.yml) reuses this same image and just overrides the
# entrypoint to run the loop instead of gunicorn.
COPY scripts/ ./scripts/

# Non-root user for security
RUN addgroup --system edapt && adduser --system --ingroup edapt edapt

# /shared_data is where docker-compose.prod.yml mounts the ingested_data_prod
# named volume (backend + scheduler services — see train_model.py's
# INGESTED_DATA_DIR). A fresh named volume is root-owned by default, which
# the non-root `edapt` user below can't write to; Docker initializes a new
# named volume's contents (including ownership) from whatever already exists
# at the mount path in the image, so creating this directory with the right
# ownership here — before the volume is mounted at container start — is what
# makes it writable by `edapt` from first boot. Confirmed necessary directly:
# without this, writing to a freshly-created ingested_data_prod volume as
# the non-root edapt user failed with "Permission denied".
RUN mkdir -p /shared_data && chown edapt:edapt /shared_data

USER edapt

EXPOSE 8000
