# ── EDAPT v2 Frontend — Production Image ──────────────────────────────────
# Stage 1: build the React app
# Stage 2: serve static files via nginx

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# CRA bakes REACT_APP_* vars into the bundle at build time, so they must
# arrive as build args (a runtime `environment:` entry on the container
# would be too late) — see docker-compose.prod.yml's frontend build.args.
ARG REACT_APP_API_BASE_URL
ARG REACT_APP_GOOGLE_CLIENT_ID
ARG REACT_APP_MICROSOFT_CLIENT_ID
ARG REACT_APP_MICROSOFT_TENANT_ID
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL \
    REACT_APP_GOOGLE_CLIENT_ID=$REACT_APP_GOOGLE_CLIENT_ID \
    REACT_APP_MICROSOFT_CLIENT_ID=$REACT_APP_MICROSOFT_CLIENT_ID \
    REACT_APP_MICROSOFT_TENANT_ID=$REACT_APP_MICROSOFT_TENANT_ID

RUN npm run build

# ── Stage 2: serve ─────────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS runner

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/build /usr/share/nginx/html

# SPA fallback: all routes serve index.html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
